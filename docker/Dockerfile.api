FROM python:3.12-slim

WORKDIR / app

# sys deps for xgboost/ scipy wheels 
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt 

COPY src/ ./src/
COPY api/ ./api/
COPY dashboard/ ./dashboard/
COPY data/ ./data/

# trained model artifacts (run python -m src.train beforehand or mount a vol at /app/models at runtime)
COPY models_1/ ./models_1/
COPY models_2/ ./models_2/
COPY models_3/ ./models_3/
COPY models_4/ ./models_4/
COPY artifacts_1/ ./artifacts_1/
COPY artifacts_2/ ./artifacts_2/
COPY artifacts_3/ ./artifacts_3/
COPY artifacts_4/ ./artifacts_4/


ENV MODEL_DIR=/app/models \
    ARTIFACT_DIR=/app/artifacts_1\
    DASHBOARD_DIR=/app/dashboard \
    SIM_TICK_SECONDS=1.5 \
    PYTHONUNBUFFERED=1

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries= \
    CMD python -c "import urllib; urllib.requestt.urlopen('http://localhost:8000/health')" || exit 1
    
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]